# =============================================================================
# AGY Telegram Bot Configuration
# Copy this file to .env and fill in at least TELEGRAM_BOT_TOKEN and
# ALLOWED_USER_IDS before starting the bot.
# =============================================================================

# --- Telegram Credentials & Access Control (REQUIRED) ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Comma-separated numeric Telegram User IDs allowed to control this VPS bot.
# Obtain your User ID via @userinfobot or @RawDataBot.
# SECURITY: The bot refuses to start if ALLOWED_USER_IDS is empty.
ALLOWED_USER_IDS=123456789

# Optional: Comma-separated allowed group/supergroup chat IDs (negative IDs).
# Leave empty to allow private chats with allowed users (and any group where an
# allowed user messages the bot). Set explicitly to restrict group usage.
ALLOWED_CHAT_IDS=

# Optional: HTTP/HTTPS/SOCKS5 proxy for Telegram API (e.g. socks5://127.0.0.1:1080)
# Note: SOCKS proxy requires `pip install "httpx[socks]"`
TELEGRAM_PROXY_URL=

# --- AGY CLI Configuration ---
# Path to `agy` binary. Defaults to `agy` (also checks ~/.local/bin/agy automatically).
AGY_BIN=agy

# Default workspace directory on the VPS for new sessions.
# Supports ~ expansion. Defaults to current working directory if omitted.
DEFAULT_WORKSPACE=~/workspace

# Optional: Comma-separated list of root directories that /cd and /get are
# allowed to access. Leave empty to allow any path accessible to the OS user.
# Example: ALLOWED_WORKSPACE_ROOTS=/home/ubuntu/projects,/srv/apps
ALLOWED_WORKSPACE_ROOTS=

# Optional: Additional workspace directories passed to `agy --add-dir` (comma-separated).
AGY_EXTRA_DIRS=

# Execution backend mode:
#   persistent (Recommended) - Keeps a warm `agy --input-format stream-json --output-format stream-json`
#                              process per active chat for fast multi-turn replies, automatically
#                              reaping idle workers after SESSION_IDLE_TIMEOUT_SECONDS.
#   oneshot                  - Runs `agy -p ... --output-format stream-json --conversation <id>`
#                              per turn (zero idle RAM, slightly higher per-turn latency).
AGY_RUNNER_MODE=persistent

# Default permission mode for new sessions:
#   default      - Follow ~/.gemini/antigravity-cli/settings.json & CLI defaults (Recommended)
#   auto         - Pass `--mode auto` (auto-approves workspace edits & safe/sandboxed commands)
#   accept-edits - Pass `--mode accept-edits` (auto-approves workspace edits)
#   plan         - Pass `--mode plan` (read-only research & planning)
#   danger       - Pass `--dangerously-skip-permissions` (full autonomous mode)
AGY_DEFAULT_PERMISSION_MODE=default

# Allow switching to `danger` (--dangerously-skip-permissions) via /perm danger.
# Set to false on sensitive production VPSes to hard-disable dangerous mode.
ALLOW_DANGEROUS_MODE=true

# Default `--sandbox` flag for new sessions (true/false).
# Enables OS-level terminal containment where supported by the host kernel.
AGY_DEFAULT_SANDBOX=false

# Optional default model slug (run `agy models` to list valid slugs).
# Leave empty to inherit the CLI default from ~/.gemini/antigravity-cli/settings.json.
AGY_DEFAULT_MODEL=

# Optional default reasoning effort (low, medium, high, xhigh, max).
# Leave empty to inherit the CLI default.
AGY_DEFAULT_EFFORT=

# Optional default custom agent name (run `agy agents` to list).
AGY_DEFAULT_AGENT=

# Disable slash-command/skill expansion inside `agy` headless prompts (true/false).
AGY_DISABLE_SLASH_COMMANDS=false

# Disable background CLI self-updater to prevent update.lock hangs under systemd.
AGY_CLI_DISABLE_AUTO_UPDATE=true

# --- Authentication Passthrough (Optional) ---
# Only needed if you are NOT using SSH OAuth keyring login:
# Option 1 (Gemini API Key): Also set `"modelProvider": "gemini"` in ~/.gemini/antigravity-cli/settings.json
# GEMINI_API_KEY=
# GOOGLE_GEMINI_BASE_URL=
#
# Option 2 (Google Cloud ADC / Gemini Enterprise):
# AGY_ADC_AUTH=true
# GOOGLE_CLOUD_QUOTA_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# --- Runtime Limits & UX ---
# Maximum time in seconds for a single agent turn (0 = unlimited). Default: 1800 (30 min).
TURN_TIMEOUT_SECONDS=1800

# Idle timeout in seconds before closing a warm persistent `agy` worker to free VPS RAM.
# Conversation ID is kept in SQLite so the next message transparently resumes.
SESSION_IDLE_TIMEOUT_SECONDS=600

# Maximum number of concurrent active turns across all chats/topics.
MAX_CONCURRENT_RUNS=3

# Minimum interval (seconds) between streaming Telegram message edits to respect rate limits.
STREAM_EDIT_INTERVAL_SECONDS=1.2

# Show tool call traces and token usage footer by default (can toggle per chat via /verbose).
DEFAULT_VERBOSE=true

# Automatically send images generated or referenced during an AGY turn directly to Telegram.
AUTO_SEND_IMAGES=true

# Maximum number of images auto-sent per turn to prevent accidental flooding.
MAX_AUTO_IMAGES=8

# Send full output as an attached .md file when response exceeds this character count (0 = disable).
LONG_OUTPUT_FILE_THRESHOLD=12000

# Maximum Telegram upload file size (MB) saved into <workspace>/.tg_inbox/
MAX_UPLOAD_MB=20

# SQLite database path for persisted sessions & conversation history.
DB_PATH=./data/bot.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
